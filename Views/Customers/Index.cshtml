@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Customer Management</h3>
        <p class="text-muted mb-0 small">Manage customer master directory, contact information, and account history.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="ExportCsv" asp-route-type="customer" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Customer
        </a>
    </div>
</div>

<!-- Search & Filtering Bar (PDF Section 17.13) -->
<div class="crm-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by name, email, 10-digit phone, company..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(ViewBag.CurrentStatus == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewBag.CurrentStatus == "Inactive")">Inactive</option>
                <option value="Prospect" selected="@(ViewBag.CurrentStatus == "Prospect")">Prospect</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select name="sortBy" class="form-select form-select-sm">
                <option value="">Newest First</option>
                <option value="date_asc" selected="@(ViewBag.CurrentSort == "date_asc")">Oldest First</option>
                <option value="name" selected="@(ViewBag.CurrentSort == "name")">Name (A-Z)</option>
                <option value="name_desc" selected="@(ViewBag.CurrentSort == "name_desc")">Name (Z-A)</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Customer Table -->
<div class="crm-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border fw-medium">@item.CustomerCode</span></td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none text-dark">
                                    @item.CustomerName
                                </a>
                            </td>
                            <td><a href="mailto:@item.Email" class="text-decoration-none small">@item.Email</a></td>
                            <td><span class="small font-monospace">@item.Phone</span></td>
                            <td>@(item.CompanyName ?? "—")</td>
                            <td>
                                <span class="badge @(item.Status == "Active" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="small text-muted">@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-outline-secondary" title="View Details"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-primary" title="Edit Customer"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-outline-danger" title="Delete Customer"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No customer records match your filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <span class="small text-muted">Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages (Total @ViewBag.TotalCount records)</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.CurrentSearch" asp-route-status="@ViewBag.CurrentStatus" asp-route-sortBy="@ViewBag.CurrentSort">@i</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
