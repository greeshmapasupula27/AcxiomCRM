@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Customer Profile - " + Model.CustomerName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h3 class="fw-bold text-dark mb-0">@Model.CustomerName</h3>
            <span class="badge bg-light text-dark border">@Model.CustomerCode</span>
            <span class="badge @(Model.Status == "Active" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") ms-1">@Model.Status</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-currency-dollar me-1"></i> Add Deal
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Customer Info Card -->
    <div class="col-12 col-lg-4">
        <div class="crm-card p-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-info-circle text-primary me-2"></i>Account Details</h5>
            <dl class="row mb-0 small">
                <dt class="col-sm-5 text-muted">Company:</dt>
                <dd class="col-sm-7 fw-semibold">@(Model.CompanyName ?? "—")</dd>

                <dt class="col-sm-5 text-muted">Email:</dt>
                <dd class="col-sm-7"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                <dt class="col-sm-5 text-muted">Phone:</dt>
                <dd class="col-sm-7 font-monospace">@Model.Phone</dd>

                <dt class="col-sm-5 text-muted">Location:</dt>
                <dd class="col-sm-7">@(Model.City != null ? $"{Model.City}, {Model.State}" : "—")</dd>

                <dt class="col-sm-5 text-muted">Address:</dt>
                <dd class="col-sm-7">@(Model.Address ?? "—")</dd>

                <dt class="col-sm-5 text-muted">Owner / Rep:</dt>
                <dd class="col-sm-7">@(Model.Owner?.FullName ?? "Unassigned")</dd>

                <dt class="col-sm-5 text-muted">Created:</dt>
                <dd class="col-sm-7">@Model.CreatedDate.ToString("MMM dd, yyyy")</dd>
            </dl>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mt-3 pt-3 border-top">
                    <h6 class="fw-bold text-muted small text-uppercase">Notes & History</h6>
                    <p class="small text-secondary mb-0">@Model.Notes</p>
                </div>
            }
        </div>
    </div>

    <!-- Related Operations Tabs -->
    <div class="col-12 col-lg-8">
        <div class="crm-card p-4">
            <ul class="nav nav-tabs mb-3" id="customerTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active fw-semibold" id="opps-tab" data-bs-toggle="tab" data-bs-target="#opps-pane" type="button">
                        Opportunities (@Model.Opportunities.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-semibold" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups-pane" type="button">
                        Follow-Ups (@Model.FollowUps.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-semibold" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities-pane" type="button">
                        Activity Log (@Model.Activities.Count)
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="customerTabsContent">
                <!-- Opportunities Pane -->
                <div class="tab-pane fade show active" id="opps-pane">
                    @if (Model.Opportunities.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle small mb-0">
                                <thead>
                                    <tr>
                                        <th>Deal Name</th>
                                        <th>Amount</th>
                                        <th>Stage</th>
                                        <th>Probability</th>
                                        <th>Expected Close</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in Model.Opportunities)
                                    {
                                        <tr>
                                            <td class="fw-semibold">
                                                <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="text-decoration-none">
                                                    @o.OpportunityName
                                                </a>
                                            </td>
                                            <td class="fw-bold text-primary">$@o.Amount.ToString("N0")</td>
                                            <td><span class="badge bg-primary">@o.Stage</span></td>
                                            <td>@o.Probability%</td>
                                            <td>@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">No active opportunities linked to this customer.</p>
                    }
                </div>

                <!-- Follow-Ups Pane -->
                <div class="tab-pane fade" id="followups-pane">
                    @if (Model.FollowUps.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle small mb-0">
                                <thead>
                                    <tr>
                                        <th>Subject</th>
                                        <th>Type</th>
                                        <th>Scheduled Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in Model.FollowUps)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@f.Subject</td>
                                            <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                            <td>@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
                                            <td><span class="badge @(f.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@f.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">No follow-ups recorded for this customer.</p>
                    }
                </div>

                <!-- Activities Pane -->
                <div class="tab-pane fade" id="activities-pane">
                    @if (Model.Activities.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle small mb-0">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Subject</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.Activities)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@a.ActivityType</span></td>
                                            <td class="fw-semibold">@a.Subject</td>
                                            <td>@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td><span class="badge bg-success">@a.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">No logged activities yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
