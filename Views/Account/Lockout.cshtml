@{
    ViewData["Title"] = "Account Locked";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-5 border-0 shadow-lg rounded-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-x fs-1"></i>
                </div>
                <h3 class="fw-bold text-danger mb-2">Account Temporarily Locked</h3>
                <p class="text-muted">
                    This account has been temporarily locked out due to multiple consecutive failed sign-in attempts, in accordance with the AcxiomCRM security policy.
                </p>
                <div class="alert alert-warning small text-start">
                    <i class="bi bi-info-circle-fill me-1"></i> The lockout duration is <strong>15 minutes</strong>. If you require immediate access, please contact an authorized System Administrator.
                </div>
                <div class="mt-3">
                    <a asp-action="Login" class="btn btn-outline-secondary me-2">Back to Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>
