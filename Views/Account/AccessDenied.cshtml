@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-5 border-0 shadow-lg rounded-4">
                <div class="text-warning mb-3">
                    <i class="bi bi-slash-circle fs-1"></i>
                </div>
                <h3 class="fw-bold mb-2">403 - Access Denied</h3>
                <p class="text-muted">
                    You do not have the required role privileges or business authorization to view this resource.
                </p>
                <div class="mt-3">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
