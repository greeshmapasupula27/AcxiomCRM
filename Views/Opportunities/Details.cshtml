@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Opportunity - " + Model.OpportunityName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h3 class="fw-bold text-dark mb-0">@Model.OpportunityName</h3>
            <span class="badge @(Model.Stage == "Won" ? "bg-success" : Model.Stage == "Lost" ? "bg-secondary" : "bg-primary")">@Model.Stage Stage</span>
            <span class="badge bg-light text-dark border ms-1">Status: @Model.Status</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Add Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Deal
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Deal Economics Card -->
    <div class="col-12 col-lg-5">
        <div class="crm-card p-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-cash-coin text-primary me-2"></i>Deal Metrics</h5>
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted d-block text-uppercase fw-semibold">Contract Amount</small>
                        <h4 class="fw-bold text-primary mb-0">$@Model.Amount.ToString("N0")</h4>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted d-block text-uppercase fw-semibold">Weighted Pipeline</small>
                        <h4 class="fw-bold text-success mb-0">$@Model.WeightedAmount.ToString("N0")</h4>
                    </div>
                </div>
            </div>

            <dl class="row mb-0 small">
                <dt class="col-sm-5 text-muted">Win Probability:</dt>
                <dd class="col-sm-7 fw-bold">@Model.Probability%</dd>

                <dt class="col-sm-5 text-muted">Customer:</dt>
                <dd class="col-sm-7">
                    @if (Model.Customer != null)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer.CustomerName</a>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </dd>

                <dt class="col-sm-5 text-muted">Associated Lead:</dt>
                <dd class="col-sm-7">
                    @if (Model.Lead != null)
                    {
                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">@Model.Lead.LeadName</a>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </dd>

                <dt class="col-sm-5 text-muted">Close Target:</dt>
                <dd class="col-sm-7">@Model.ExpectedCloseDate.ToString("MMMM dd, yyyy")</dd>

                <dt class="col-sm-5 text-muted">Deal Owner:</dt>
                <dd class="col-sm-7">@(Model.AssignedUser?.FullName ?? "Unassigned")</dd>

                <dt class="col-sm-5 text-muted">Created:</dt>
                <dd class="col-sm-7">@Model.CreatedDate.ToString("yyyy-MM-dd")</dd>
            </dl>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mt-3 pt-3 border-top">
                    <h6 class="fw-bold text-muted small text-uppercase">Deal Strategy Notes</h6>
                    <p class="small text-secondary mb-0">@Model.Notes</p>
                </div>
            }
        </div>
    </div>

    <!-- Related Follow-Ups on Opportunity -->
    <div class="col-12 col-lg-7">
        <div class="crm-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-calendar-check text-info me-2"></i>Scheduled Actions</h5>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg"></i> Add
                </a>
            </div>

            @if (Model.FollowUps.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead>
                            <tr>
                                <th>Action / Subject</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FollowUps)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td>@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge @(f.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@f.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4 mb-0">No follow-ups recorded for this deal yet.</p>
            }
        </div>
    </div>
</div>
