@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-arrow-left"></i></a>
            <h4 class="fw-bold mb-0">Create Sales Opportunity Deal</h4>
        </div>

        <div class="crm-card p-4">
            <form asp-action="Create" method="post" id="opportunityForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="OpportunityName" class="form-label fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                        <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise Cloud License Renewal" />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label fw-semibold">Customer Account</label>
                        <select asp-for="CustomerId" asp-items="@ViewBag.CustomersList" class="form-select">
                            <option value="">-- Select Existing Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label fw-semibold">Originating Lead</label>
                        <select asp-for="LeadId" asp-items="@ViewBag.LeadsList" class="form-select">
                            <option value="">-- Optional Associated Lead --</option>
                        </select>
                        <span asp-validation-for="LeadId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label fw-semibold">Deal Amount ($) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Amount" class="form-control" id="oppAmount" type="number" step="0.01" min="0.01" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                        <div class="form-text small">Must be greater than 0.</div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Probability" class="form-label fw-semibold">Probability (%) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="Probability" class="form-control" id="oppProb" type="number" min="0" max="100" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="Probability" class="text-danger small"></span>
                        <div class="form-text small">Value between 0 and 100.</div>
                    </div>

                    <!-- Live Calculated Weighted Amount Box -->
                    <div class="col-12">
                        <div class="alert alert-light border py-2 px-3 d-flex justify-content-between align-items-center mb-0">
                            <span class="small text-muted fw-semibold">Derived Weighted Pipeline: Amount &times; Probability / 100</span>
                            <span class="fw-bold text-success fs-5" id="weightedPreview">$2,500</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Stage" class="form-label fw-semibold">Pipeline Stage <span class="text-danger">*</span></label>
                        <select asp-for="Stage" class="form-select" id="oppStage">
                            <option value="Qualification">Qualification</option>
                            <option value="Proposal">Proposal</option>
                            <option value="Negotiation">Negotiation</option>
                            <option value="Won">Won</option>
                            <option value="Lost">Lost</option>
                        </select>
                        <span asp-validation-for="Stage" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpectedCloseDate" class="form-label fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
                        <input asp-for="ExpectedCloseDate" class="form-control" type="date" id="oppCloseDate" />
                        <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        <div class="form-text small">Cannot be in the past for active opportunities.</div>
                    </div>

                    <div class="col-12">
                        <label asp-for="AssignedTo" class="form-label fw-semibold">Assigned Deal Owner</label>
                        <select asp-for="AssignedTo" asp-items="@ViewBag.UsersList" class="form-select">
                            <option value="">-- Unassigned --</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold">Opportunity Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Competitor analysis, pricing concessions, decision makers..."></textarea>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Save Opportunity
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function updateWeighted() {
            const amt = parseFloat(document.getElementById('oppAmount').value) || 0;
            const prob = parseFloat(document.getElementById('oppProb').value) || 0;
            const weighted = (amt * prob) / 100;
            document.getElementById('weightedPreview').innerText = '$' + weighted.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 2});
        }
        document.getElementById('oppAmount').addEventListener('input', updateWeighted);
        document.getElementById('oppProb').addEventListener('input', updateWeighted);
        updateWeighted();

        // Enforce close date min date = today
        const todayStr = new Date().toISOString().split('T')[0];
        document.getElementById('oppCloseDate').setAttribute('min', todayStr);
    </script>
}
