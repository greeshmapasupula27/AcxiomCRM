@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Edit Lead";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-arrow-left"></i></a>
            <h4 class="fw-bold mb-0">Edit Lead: @Model.LeadName</h4>
        </div>

        <div class="crm-card p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LeadId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="LeadCode" class="form-label fw-semibold">Lead Code</label>
                        <input asp-for="LeadCode" class="form-control" readonly />
                    </div>

                    <div class="col-md-8">
                        <label asp-for="LeadName" class="form-label fw-semibold">Prospect Full Name <span class="text-danger">*</span></label>
                        <input asp-for="LeadName" class="form-control" />
                        <span asp-validation-for="LeadName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold">Phone (10 Digits) <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control" maxlength="10" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label fw-semibold">Company</label>
                        <input asp-for="CompanyName" class="form-control" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Source" class="form-label fw-semibold">Source</label>
                        <select asp-for="Source" class="form-select">
                            <option value="Website">Website</option>
                            <option value="Referral">Referral</option>
                            <option value="Cold Call">Cold Call</option>
                            <option value="Advertisement">Advertisement</option>
                            <option value="Partner">Partner Channel</option>
                            <option value="Trade Show">Trade Show</option>
                        </select>
                        <span asp-validation-for="Source" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label fw-semibold">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="New">New</option>
                            <option value="Contacted">Contacted</option>
                            <option value="Qualified">Qualified</option>
                            <option value="Unqualified">Unqualified</option>
                            <option value="Converted">Converted</option>
                            <option value="Lost">Lost</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Priority" class="form-label fw-semibold">Priority</label>
                        <select asp-for="Priority" class="form-select">
                            <option value="High">High</option>
                            <option value="Medium">Medium</option>
                            <option value="Low">Low</option>
                        </select>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ExpectedValue" class="form-label fw-semibold">Expected Value ($)</label>
                        <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="AssignedTo" class="form-label fw-semibold">Assigned Rep</label>
                        <select asp-for="AssignedTo" asp-items="@ViewBag.UsersList" class="form-select">
                            <option value="">-- Unassigned --</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Update Lead
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
