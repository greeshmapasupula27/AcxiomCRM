@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Lead Profile - " + Model.LeadName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h3 class="fw-bold text-dark mb-0">@Model.LeadName</h3>
            <span class="badge bg-light text-dark border">@Model.LeadCode</span>
            <span class="badge @(Model.Status == "Converted" ? "bg-success" : Model.Status == "Qualified" ? "bg-primary" : "bg-info text-dark") ms-1">@Model.Status</span>
            <span class="badge @(Model.Priority == "High" ? "bg-danger" : "bg-secondary") ms-1">@Model.Priority Priority</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer
            </a>
        }
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-telephone-plus me-1"></i> Log Activity
        </a>
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="crm-card p-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-funnel text-success me-2"></i>Prospect Summary</h5>
            <dl class="row mb-0 small">
                <dt class="col-sm-5 text-muted">Company:</dt>
                <dd class="col-sm-7 fw-semibold">@(Model.CompanyName ?? "—")</dd>

                <dt class="col-sm-5 text-muted">Email:</dt>
                <dd class="col-sm-7"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                <dt class="col-sm-5 text-muted">Phone:</dt>
                <dd class="col-sm-7 font-monospace">@Model.Phone</dd>

                <dt class="col-sm-5 text-muted">Source:</dt>
                <dd class="col-sm-7"><span class="badge bg-light text-dark border">@Model.Source</span></dd>

                <dt class="col-sm-5 text-muted">Expected Value:</dt>
                <dd class="col-sm-7 fw-bold text-success">$@Model.ExpectedValue.ToString("N0")</dd>

                <dt class="col-sm-5 text-muted">Assigned Rep:</dt>
                <dd class="col-sm-7">@(Model.AssignedUser?.FullName ?? "Unassigned")</dd>

                <dt class="col-sm-5 text-muted">Created Date:</dt>
                <dd class="col-sm-7">@Model.CreatedDate.ToString("MMM dd, yyyy")</dd>
            </dl>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mt-3 pt-3 border-top">
                    <h6 class="fw-bold text-muted small text-uppercase">Discovery Notes</h6>
                    <p class="small text-secondary mb-0">@Model.Notes</p>
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="crm-card p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-primary me-2"></i>Engagement History</h5>
            @if (Model.FollowUps.Any() || Model.Activities.Any())
            {
                <div class="list-group list-group-flush small">
                    @foreach (var f in Model.FollowUps)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <span class="badge bg-info text-dark me-2">Follow-Up (@f.FollowUpType)</span>
                                <strong>@f.Subject</strong>
                                <div class="text-muted small">@f.Remarks</div>
                            </div>
                            <span class="text-muted">@f.FollowUpDate.ToString("yyyy-MM-dd")</span>
                        </div>
                    }
                    @foreach (var a in Model.Activities)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <span class="badge bg-secondary me-2">Activity (@a.ActivityType)</span>
                                <strong>@a.Subject</strong>
                                <div class="text-muted small">@a.Description</div>
                            </div>
                            <span class="text-muted">@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4 mb-0">No engagements recorded yet for this lead.</p>
            }
        </div>
    </div>
</div>
