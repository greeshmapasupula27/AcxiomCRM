@model IEnumerable<AcxiomCRM.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-person-gear text-danger me-2"></i>User & Role Administration</h3>
        <p class="text-muted mb-0 small">Administer team accounts, role-based authorization scopes, lockout resets, and security governance.</p>
    </div>
    <a asp-action="Create" class="btn btn-danger btn-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Provision New User
    </a>
</div>

<div class="crm-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>User Details</th>
                    <th>Role Scope</th>
                    <th>Reporting Manager</th>
                    <th>Account Status</th>
                    <th>Lockout Security</th>
                    <th>Failed Logins</th>
                    <th>Registered</th>
                    <th class="text-end">Administrative Controls</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@u.FullName</div>
                            <small class="text-muted">@u.Email</small>
                        </td>
                        <td>
                            <span class="badge @(u.Role == "Admin" ? "badge-role-admin" : u.Role == "Manager" ? "badge-role-manager" : "badge-role-sales")">
                                @u.Role
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(u.ManagerName))
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-person-badge me-1"></i>@u.ManagerName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(u.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">
                                <i class="bi @(u.IsActive ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                @(u.IsActive ? "Active" : "Deactivated")
                            </span>
                        </td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger text-white"><i class="bi bi-lock-fill me-1"></i> Locked Out</span>
                                <small class="text-muted d-block font-monospace">Until @u.LockoutEnd?.ToString("HH:mm")</small>
                            }
                            else
                            {
                                <span class="badge bg-light text-success border"><i class="bi bi-unlock-fill me-1"></i> Normal</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(u.AccessFailedCount > 0 ? "bg-warning text-dark" : "bg-light text-muted border")">
                                @u.AccessFailedCount / 5
                            </span>
                        </td>
                        <td class="small text-muted">@u.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="EditRole" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Change Role Scope">
                                    <i class="bi bi-shield-lock"></i> Role
                                </a>
                                @if (u.IsLockedOut || u.AccessFailedCount > 0)
                                {
                                    <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-warning" title="Unlock Account">
                                            <i class="bi bi-unlock"></i> Unlock
                                        </button>
                                    </form>
                                }
                                <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-outline-secondary" title="Reset Password">
                                    <i class="bi bi-key"></i> Reset Pwd
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                        @(u.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
