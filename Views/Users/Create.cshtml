@model AcxiomCRM.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Provision User";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-arrow-left"></i></a>
            <h4 class="fw-bold mb-0">Provision New User Account</h4>
        </div>

        <div class="crm-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Rachel Adams" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold">Corporate Email <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" placeholder="rachel@acxiomcrm.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-semibold">Role Scope <span class="text-danger">*</span></label>
                        <select asp-for="Role" class="form-select">
                            <option value="SalesExecutive">SalesExecutive (Assigned Records Only)</option>
                            <option value="Manager">Manager (Team CRM & Management Reports)</option>
                            <option value="Admin">Admin (Full System Administration)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ManagerId" class="form-label fw-semibold">Reporting Manager</label>
                        <select asp-for="ManagerId" asp-items="ViewBag.ManagersList" class="form-select">
                            <option value="">-- No Direct Manager (Independent) --</option>
                        </select>
                        <span asp-validation-for="ManagerId" class="text-danger small"></span>
                        <small class="text-muted">Recommended when role is SalesExecutive to link to Manager's team scope.</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold">Initial Password <span class="text-danger">*</span></label>
                        <input asp-for="Password" class="form-control" placeholder="Password@123" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4 fw-semibold">
                        <i class="bi bi-person-check-fill me-1"></i> Provision Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
