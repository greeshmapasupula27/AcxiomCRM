@model AcxiomCRM.ViewModels.ResetPasswordAdminViewModel
@{
    ViewData["Title"] = "Admin Password Reset";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-arrow-left"></i></a>
            <h4 class="fw-bold mb-0">Reset User Password</h4>
        </div>

        <div class="crm-card p-4">
            <div class="alert alert-info py-2 small mb-3">
                Resetting password for user: <strong>@Model.UserEmail</strong>
            </div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="UserEmail" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold">New Compliant Password</label>
                    <input asp-for="NewPassword" class="form-control" placeholder="Min 8 chars, 1 digit, 1 upper, 1 special" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-key-fill me-1"></i> Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
