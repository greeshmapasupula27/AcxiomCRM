@model AcxiomCRM.ViewModels.UserEditRoleViewModel
@{
    ViewData["Title"] = "Modify User Role";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-arrow-left"></i></a>
            <h4 class="fw-bold mb-0">Modify Role Assignment</h4>
        </div>

        <div class="crm-card p-4">
            <div class="alert alert-light border small mb-3">
                <div><strong>User:</strong> @Model.FullName (@Model.UserEmail)</div>
                <div><strong>Current Role:</strong> <span class="badge bg-secondary">@Model.CurrentRole</span></div>
            </div>

            <form asp-action="EditRole" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="UserEmail" />
                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="CurrentRole" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="NewRole" class="form-label fw-semibold">Assign New Role Scope</label>
                    <select asp-for="NewRole" class="form-select">
                        <option value="SalesExecutive">SalesExecutive (Assigned Records Only)</option>
                        <option value="Manager">Manager (Team CRM Data & Pipeline Reports)</option>
                        <option value="Admin">Admin (Full System & Security Administration)</option>
                    </select>
                    <span asp-validation-for="NewRole" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-shield-check me-1"></i> Update Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
